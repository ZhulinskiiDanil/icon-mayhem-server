# Railway sets these two by itself
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/icon_mayhem

# Moderators: GD account ids (comma separated) that can hide and delete any look in the game
ADMIN_ACCOUNT_IDS=
# Key for the /v1/admin endpoints without an account (header X-Admin-Key). Make it long and random
ADMIN_KEY=

# Optional
# DATABASE_SSL=1            # a database outside Railway that wants TLS
# REPORT_HIDE=5             # reports that hide a look until a moderator looks
# MAX_LOOKS_PER_ACCOUNT=30
# MAX_LOOKS_PER_DAY=10
# SESSION_DAYS=30
# AUTH_DEV=1                # local testing only: logins are not checked. NEVER on the real server
